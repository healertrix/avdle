// Cloudflare Workers config for Avdle.
// Deploy: npx wrangler deploy   (Workers Builds runs this for you when connected to GitHub)
{
  "name": "avdle",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // the game's static files are served straight from the repo; .assetsignore keeps the rest private
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // multiplayer rooms: one Durable Object holds them all, so every player reaches the same rooms
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Rooms" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Rooms"] }]
}

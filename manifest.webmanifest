{
  "id": "/",
  "name": "Avdle",
  "short_name": "Avdle",
  "description": "A geography game: pin a country that fits the prompt, name a famous person from where they lived, or guess the year. The less obvious your answer, the more it scores.",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#bcd4e8",
  "theme_color": "#ffffff",
  "categories": [
    "games",
    "education"
  ],
  "icons": [
